classTweaker v1 official

# ---------------------------------------------------------------------------
# Minecraft: allow replacing the toast manager with BetterToastManager.
# ---------------------------------------------------------------------------
accessible field net/minecraft/client/Minecraft toastManager Lnet/minecraft/client/gui/components/toasts/ToastManager;
mutable    field net/minecraft/client/Minecraft toastManager Lnet/minecraft/client/gui/components/toasts/ToastManager;

# ---------------------------------------------------------------------------
# ToastManager: state we read/write, plus two private methods we override.
# ---------------------------------------------------------------------------
accessible field net/minecraft/client/gui/components/toasts/ToastManager visibleToasts Ljava/util/List;
accessible field net/minecraft/client/gui/components/toasts/ToastManager occupiedSlots Ljava/util/BitSet;
accessible field net/minecraft/client/gui/components/toasts/ToastManager queued Ljava/util/Deque;
accessible field net/minecraft/client/gui/components/toasts/ToastManager playedToastSounds Ljava/util/Set;
accessible field net/minecraft/client/gui/components/toasts/ToastManager nowPlayingToast Lnet/minecraft/client/gui/components/toasts/ToastManager$ToastInstance;

accessible method net/minecraft/client/gui/components/toasts/ToastManager findFreeSlotsIndex (I)I
extendable method net/minecraft/client/gui/components/toasts/ToastManager findFreeSlotsIndex (I)I
accessible method net/minecraft/client/gui/components/toasts/ToastManager freeSlotCount ()I
extendable method net/minecraft/client/gui/components/toasts/ToastManager freeSlotCount ()I

# ---------------------------------------------------------------------------
# ToastManager$ToastInstance: subclassed by BetterToastInstance.
